// Site SOBIMA : pages statiques (../site-v4) + formulaire de contact et suggestions d'adresses (/api/*).
// Secret à poser hors du dépôt : RESEND_API_KEY (`npx wrangler secret put RESEND_API_KEY`, ou .dev.vars en local).
{
  "name": "sobima",
  "main": "src/index.js",
  "compatibility_date": "2026-10-19",
  // URL workers.dev activée pour tester avant la bascule des domaines.
  "workers_dev": true,
  // Domaines de production. www est l'adresse canonique ; l'apex sert le même site.
  "routes": [
    { "pattern": "www.sobima.fr", "custom_domain": true },
    { "pattern": "sobima.fr", "custom_domain": true }
  ],
  "assets": {
    "directory": "../site-v4",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "vars": {
    "CONTACT_DESTINATAIRE": "contact@sobima.fr",
    "CONTACT_EXPEDITEUR": "Site SOBIMA <formulaire@sobima.fr>"
  },
  // Compteurs de conversions (clics tél/e-mail, demandes envoyées), sans cookie.
  "analytics_engine_datasets": [
    { "binding": "EVENEMENTS", "dataset": "sobima_evenements" }
  ],
  // Limites par adresse IP : 5 envois et 60 recherches d'adresse par minute
  "ratelimits": [
    { "name": "LIMITE_CONTACT", "namespace_id": "4101", "simple": { "limit": 5, "period": 60 } },
    { "name": "LIMITE_ADRESSE", "namespace_id": "4102", "simple": { "limit": 60, "period": 60 } },
    { "name": "LIMITE_EVENEMENT", "namespace_id": "4103", "simple": { "limit": 30, "period": 60 } }
  ]
}
